{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSV Dashboard",
  "version": "0.1.0",
  "identifier": "com.bybunni.csvdashboard",
  "build": {
    "beforeDevCommand": "npm run serve:tauri-dev",
    "beforeBuildCommand": "npm run prepare:app-web-assets",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../app-web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CSV Dashboard",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
